# -----------------------------------------------------------------------------
# Copy to .env.local for local development. NEVER commit real values.
# -----------------------------------------------------------------------------

# Supabase project URL and publishable (anon) key.
# Dashboard → Project Settings → API. These are safe to expose to the browser;
# all data access is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Supabase service-role / secret key. SERVER ONLY — never prefix with NEXT_PUBLIC_.
# Used for: OTP rate limiting + allowlist pre-check, account deletion,
# removing storage files, and the scheduled retention job.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Random secret (32+ chars) used to hash rate-limit keys (so raw phone numbers and
# IPs are never stored). Generate with:  openssl rand -hex 32
APP_SECRET=replace-with-64-random-hex-characters

# Public URL of the app (used for same-origin checks on API routes).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Name shown in the UI.
NEXT_PUBLIC_APP_NAME=Ghostline

# Secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>" when calling
# /api/cron/retention. Generate with:  openssl rand -hex 32
CRON_SECRET=replace-with-another-random-secret
