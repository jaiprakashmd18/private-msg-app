# -----------------------------------------------------------------------------
# Copy to .env.local for local development. NEVER commit real values.
# -----------------------------------------------------------------------------

# Supabase project URL and publishable (anon) key.
# Dashboard → Project Settings → API. These are safe to expose to the browser;
# all data access is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Supabase service-role / secret key. SERVER ONLY — never prefix with NEXT_PUBLIC_.
# Used for: account deletion, removing storage files, and the scheduled
# retention job.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Public URL of the app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Name shown in the UI.
NEXT_PUBLIC_APP_NAME=Loveline

# Secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>" when calling
# /api/cron/retention. Generate with:  openssl rand -hex 32
CRON_SECRET=replace-with-a-random-secret

# Optional: turns on GIF search in the sticker panel. Free key: create an app
# ("API", not SDK) at https://developers.giphy.com/dashboard and paste its key.
# GIPHY_API_KEY=

# -----------------------------------------------------------------------------
# Loveline Plus payments (all optional — each gateway shows only when its keys
# are set). See docs/MONETIZATION.md.
# -----------------------------------------------------------------------------

# Razorpay — India (UPI / Google Pay / cards). One-time lifetime unlock.
# Key Id is public (shows the button); the secret is SERVER ONLY.
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# RAZORPAY_AMOUNT=39900          # price in paise (39900 = ₹399)
# RAZORPAY_CURRENCY=INR
# RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Label shown on the pay button, e.g. "₹399 · lifetime".
# NEXT_PUBLIC_PLUS_PRICE=₹399 · lifetime

# Stripe — cards outside India. Set NEXT_PUBLIC_STRIPE_ENABLED=1 to show the
# "Pay by card" button.
# NEXT_PUBLIC_STRIPE_ENABLED=1
# STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# STRIPE_PRICE_ID=price_xxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# RevenueCat — Apple/Google in the store apps (webhook bearer secret).
# REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-secret
